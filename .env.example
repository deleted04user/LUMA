# Get an Access Key at https://unsplash.com/developers (never use your Secret Key).
# Optional: npm run build embeds this public client identifier in dist/config.js.
# npm start uses API setup or config.js instead; browsers cannot read .env files.
UNSPLASH_ACCESS_KEY=

# Optional process environment for npm start/preview; default 8000.
# Compose also reads this from .env for the published host port (container stays on 8000).
PORT=8000

# Provided automatically by GitHub Actions; set CI=true in the shell for CI browser behavior.
# Playwright does not load .env. Leave this empty for ordinary local development.
CI=
