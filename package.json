{
  "name": "luma-photo-search",
  "version": "1.1.0",
  "private": true,
  "description": "A framework-free Unsplash photo search client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deleted04user/LUMA.git"
  },
  "homepage": "https://deleted04user.github.io/LUMA/",
  "keywords": [
    "frontend",
    "static-site",
    "javascript",
    "unsplash",
    "image-search"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25 || >=26"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "build": "node --env-file-if-exists=.env tools/build.mjs",
    "preview": "node tools/serve.mjs --dist",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/*.js --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 tests/*.test.mjs",
    "test:coverage": "npm test",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "deployment:check": "node tools/check-deployment.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run deployment:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
